include requirements.lock Dockerfile .dockerignore .env.example .gitignore CONTRIBUTING.md
recursive-include docs *.md *.json
recursive-include examples *.py *.md
recursive-include configs *.json
exclude configs/*.local.json
recursive-include datasets *.md
recursive-include benchmarks *.md *.json
recursive-include tests *.py
global-exclude __pycache__ *.py[cod]
