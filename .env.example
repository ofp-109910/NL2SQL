# 复制为项目根目录 .env 后填写；实际 .env 不提交。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 相对于项目工作目录；所有生成数据、日志与报告位于此目录。
NL2SQL_OUTPUT_DIR=outputs

# 可选：使用单行密钥文件时设置；DEEPSEEK_API_KEY 优先。
# NL2SQL_API_KEY_FILE=.secrets/deepseek_api
# 从其他目录启动时，在外部环境中指定 NL2SQL_HOME=/path/to/nl2sql-handbook。
